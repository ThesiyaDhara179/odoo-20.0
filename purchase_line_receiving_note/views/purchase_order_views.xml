<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Purchase Order Form View to add receiving_note field -->
    <record id="purchase_order_form_inherit_receiving_note" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.receiving.note</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="receiving_note" optional="show" placeholder="Receiving instructions..."/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='name']" position="after">
                <field name="receiving_note" placeholder="Receiving instructions..."/>
            </xpath>
        </field>
    </record>

</odoo>
