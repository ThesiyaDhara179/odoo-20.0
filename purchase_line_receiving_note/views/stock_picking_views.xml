<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Stock Picking Form View to display read-only receiving_note on stock moves -->
    <record id="view_picking_form_inherit_receiving_note" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.receiving.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                <field name="receiving_note" readonly="1" optional="show" string="Receiving Note"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Stock Move Form View to display read-only receiving_note -->
    <record id="view_move_form_inherit_receiving_note" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.receiving.note</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="receiving_note" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
